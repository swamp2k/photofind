{
  "name": "photofind",
  "version": "0.6.0",
  "description": "Browser-native local photo finder and curation tool",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "build": "vite build --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --config vitest.lite.config.ts"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "maplibre-gl": "^5.24.0",
    "piexifjs": "^1.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
